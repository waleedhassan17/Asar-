# ---------------------------------------------------------------------
# Asar — copy to .env.local and fill in.
# Supabase → Project Settings → API
# ---------------------------------------------------------------------

# Safe to expose to the browser. With the RLS in supabase/migrations this
# key can only read public rows and call the granted api_* functions.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row level security completely. Used for proof
# photo uploads. Never prefix it with NEXT_PUBLIC_, never commit it, and
# rotate it immediately if it ever lands in a file or a chat window.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build absolute share links. On Vercel this is inferred, so it's
# only needed locally or behind a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Only needed to run `npm run db:push`. This is a Postgres connection
# string, not an API key: Supabase → Project Settings → Database →
# Connection string.
#
# Use the SESSION POOLER string (port 5432, user postgres.PROJECT). The
# "direct connection" host db.PROJECT.supabase.co is IPv6-only on current
# projects and fails on IPv4-only networks. Don't use the transaction
# pooler on port 6543 — it can't run these migrations.
#
# Substitute your real password: the dashboard prints [YOUR-PASSWORD] as
# a placeholder, not as a value.
#
#   postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# ---------------------------------------------------------------------
SUPABASE_DB_URL=

# ---------------------------------------------------------------------
# Platform admin, used only by `npm run admin:seed` to create or update
# the admin account and grant it is_admin. Nothing at runtime reads these.
# Keep them in .env.local only — they do not belong in Vercel.
# ---------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
